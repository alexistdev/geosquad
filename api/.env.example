# --- Aplikasi ---
APP_NAME=geosquad-api
# development | production
APP_ENV=development
# geobill pakai 8083, geolicense 8082, geosquad 8084
APP_PORT=8084

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=geosquad
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth ---
# WAJIB diisi, minimal 32 karakter. Generate dengan: make secret
JWT_SECRET=
JWT_EXPIRATION=24h
SESSION_TTL=24h
SESSION_COOKIE_NAME=SID
# WAJIB true di production. Cookie sesi tanpa Secure bisa terkirim lewat HTTP polos.
SESSION_COOKIE_SECURE=false

# --- Engine ---
# Relatif terhadap folder api/, atau isi dengan path absolut.
ENGINE_DIR=../engine
ENGINE_PYTHON=../engine/.venv/bin/python
# Berapa run engine boleh jalan bersamaan. Tiap run memakai CPU dan kuota LLM.
ENGINE_MAX_CONCURRENT=2
ENGINE_TIMEOUT=60m

# --- CORS ---
# Dipisah koma. Wildcard * tidak didukung karena API ini memakai cookie sesi.
CORS_ALLOWED_ORIGINS=http://localhost:4200
