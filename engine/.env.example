# --- 9router / OpenRouter ---
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=openai/openrouter/minimax/minimax-m3:free

# --- Model per peran. Kosongkan untuk ikut NINE_ROUTER_MODEL. ---
# Isi SQUAD_MODEL_DEV duluan kalau nanti punya model berbayar.
SQUAD_MODEL_LEAD=
SQUAD_MODEL_DEV=
SQUAD_MODEL_QA=
SQUAD_MODEL_OPS=

# --- Perilaku squad ---
# Nomor tiket. Normalnya diisi API (geo-1001, geo-1002, ...). Kalau kosong dan
# engine dijalankan manual, dipakai penanda waktu: local-20260920-004404.
SQUAD_TICKET=
# Akar folder. Tiap tiket dapat subfolder sendiri di dalamnya:
#   <SQUAD_WORKSPACE>/geo-1001   kode yang dibangun squad
#   <SQUAD_OUTPUT>/geo-1001      laporan tiap tahap
#   <SQUAD_VENVS_DIR>/geo-1001   venv untuk menjalankan test tiket itu
SQUAD_WORKSPACE=
SQUAD_OUTPUT=
SQUAD_VENVS_DIR=
# Menimpa lokasi venv untuk SATU tiket saja. Kosongkan kecuali paham
# konsekuensinya. WAJIB di luar workspace.
SQUAD_VENV_DIR=
# 1 = requirements.txt dari agent dipasang otomatis ke venv workspace
SQUAD_ALLOW_DEPS=1
# Kosongkan. Perintah test dipilih otomatis sesuai bahasa project (lihat
# squad/stacks.py). Isi hanya kalau ingin memaksa satu perintah untuk semua
# bahasa; deteksi otomatis akan dilewati.
SQUAD_TEST_COMMAND=
SQUAD_MAX_QA_ROUNDS=3
SQUAD_MAX_RPM=10

# --- Dipakai deploy.sh ---
DEPLOY_HOST=
DEPLOY_PATH=
SERVICE_NAME=
HEALTH_URL=

# --- Saklar peran ---
# 0 = DevOps mati (default, aman), 1 = aktifkan deploy
SQUAD_ENABLE_DEVOPS=0
